{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "employee-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/employees/{**catch-all}"
        }
      },
      "employee-base-route": {
        "ClusterId": "employee-cluster",
        "Match": {
          "Path": "/api/employees"
        }
      },
      "schedule-route": {
        "ClusterId": "schedule-cluster",
        "Match": {
          "Path": "/api/schedules/{**catch-all}"
        }
      },
      "schedule-base-route": {
        "ClusterId": "schedule-cluster",
        "Match": {
          "Path": "/api/schedules"
        }
      },
      "finance-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/finance/{**catch-all}"
        }
      },
      "finance-base-route": {
        "ClusterId": "finance-cluster",
        "Match": {
          "Path": "/api/finance"
        }
      },
      "ocr-route": {
        "ClusterId": "ocr-cluster",
        "Match": {
          "Path": "/api/ocr/{**catch-all}"
        }
      },
      "ocr-base-route": {
        "ClusterId": "ocr-cluster",
        "Match": {
          "Path": "/api/ocr"
        }
      }
    },
    "Clusters": {
      "employee-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "schedule-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "finance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "ocr-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      }
    }
  }
}
