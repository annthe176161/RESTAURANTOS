# =================================================================
# RestaurantOS - Environment Configuration Template
# Copy this file to .env for local overrides (NEVER commit .env)
# =================================================================

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Ports Configuration
GATEWAY_HTTP_PORT=5000
EMPLOYEE_SERVICE_HTTP_PORT=5001
SCHEDULE_SERVICE_HTTP_PORT=5002
FINANCE_SERVICE_HTTP_PORT=5003
OCR_SERVICE_HTTP_PORT=5004

# Connection Strings (Local SQLite Defaults)
EMPLOYEE_DB_CONNECTION="Data Source=employee.db"
SCHEDULE_DB_CONNECTION="Data Source=schedule.db"
FINANCE_DB_CONNECTION="Data Source=finance.db"
OCR_DB_CONNECTION="Data Source=ocr.db"

# Internal Service URLs (Used by API Gateway)
SERVICES__EMPLOYEE__URL="http://localhost:5001"
SERVICES__SCHEDULE__URL="http://localhost:5002"
SERVICES__FINANCE__URL="http://localhost:5003"
SERVICES__OCR__URL="http://localhost:5004"

