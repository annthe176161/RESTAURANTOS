# Stage 1: Build & Publish
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy CPM and Build configurations
COPY Directory.Build.props .
COPY Directory.Packages.props .

# Copy Finance project files and restore
COPY backend/services/finance/RestaurantOS.Finance.Domain/*.csproj backend/services/finance/RestaurantOS.Finance.Domain/
COPY backend/services/finance/RestaurantOS.Finance.Application/*.csproj backend/services/finance/RestaurantOS.Finance.Application/
COPY backend/services/finance/RestaurantOS.Finance.Infrastructure/*.csproj backend/services/finance/RestaurantOS.Finance.Infrastructure/
COPY backend/services/finance/RestaurantOS.Finance.Api/*.csproj backend/services/finance/RestaurantOS.Finance.Api/

RUN dotnet restore backend/services/finance/RestaurantOS.Finance.Api/RestaurantOS.Finance.Api.csproj

# Copy source code and publish
COPY backend/services/finance/ backend/services/finance/
RUN dotnet publish backend/services/finance/RestaurantOS.Finance.Api/RestaurantOS.Finance.Api.csproj -c Release -o /app/publish /p:UseAppHost=false

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
EXPOSE 5003
ENV ASPNETCORE_URLS=http://+:5003

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "RestaurantOS.Finance.Api.dll"]
